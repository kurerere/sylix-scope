{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SylixScope",
    "version": "1.0.12",
    "identifier": "io.github.kurerere.sylixscope",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "SylixScope",
                "width": 1400,
                "height": 920,
                "titleBarStyle": "Overlay",
                "transparent": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
